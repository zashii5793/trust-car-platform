<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Sign in with Apple.

	  App Store Review Guideline 4.8: an app that offers a third-party login
	  (this app offers Google) must also offer Sign in with Apple.
	  `SignInWithAppleButton` has been in the login screen for a while, but
	  until 2026-09-22 there was no entitlements file at all, so the button
	  was there and tapping it failed. This declares the capability.
	-->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!--
	  Push notifications (firebase_messaging).

	  `development` is what a debug/TestFlight build needs. Xcode rewrites
	  this to `production` when archiving with a distribution profile, so it
	  does not need a second file.
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
