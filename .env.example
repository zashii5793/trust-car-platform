# =============================================================================
# TrustCar Platform — environment variables template
# =============================================================================
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
#   cp .env.example .env
#
# These values can be supplied two ways (first non-empty wins):
#   1. --dart-define at build/run time  (recommended for CI / release)
#      e.g. flutter build apk --dart-define=REVENUE_CAT_API_KEY_ANDROID=goog_xxx
#   2. this `.env` file, loaded at runtime via flutter_dotenv (local dev)
#
# NEVER commit real keys. Do not hard-code them in Dart source.
# -----------------------------------------------------------------------------

# AI Chat — base URL of the deployed Cloud Functions (askCarAi endpoint).
# Used by lib/services/ai_chat_service.dart.
FIREBASE_FUNCTIONS_URL=https://asia-northeast1-trust-car-platform.cloudfunctions.net

# RevenueCat — platform-specific PUBLIC SDK keys (not the secret API key).
# Get them from RevenueCat Dashboard → Project → API keys.
# Used by lib/services/revenue_cat_service.dart.
REVENUE_CAT_API_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxxxxxx
REVENUE_CAT_API_KEY_ANDROID=goog_xxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps Platform — API key (planned, see Issue #41 / #43).
# Restrict by package name + SHA-1 (Android) / Bundle ID (iOS) in Google Cloud.
# MAPS_API_KEY=AIza_xxxxxxxxxxxxxxxxxxxxxxxx
