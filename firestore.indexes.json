{
  "indexes": [

    // =========================================================
    // vehicles
    // =========================================================
    {
      "collectionGroup": "vehicles",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },

    // =========================================================
    // maintenance_records
    // =========================================================
    {
      "collectionGroup": "maintenance_records",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "vehicleId", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    // 車両の整備履歴一覧。firestore.rules が
    // resource.data.userId == request.auth.uid を要求するため、クエリ側にも
    // userId 条件が必要（無いと一覧が PERMISSION_DENIED で弾かれる）。
    {
      "collectionGroup": "maintenance_records",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "vehicleId", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "maintenance_records",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "vehicleId", "order": "ASCENDING" },
        { "fieldPath": "type", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },

    // =========================================================
    // vehicle_masters/{makers|models}/items（車両マスタ・import_vehicle_master.js で投入）
    // =========================================================
    // メーカー一覧: isActive + displayOrder（VehicleMasterService.getMakers）
    {
      "collectionGroup": "items",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "displayOrder", "order": "ASCENDING" }
      ]
    },
    // 車種一覧: makerId + isActive + displayOrder（VehicleMasterService.getModelsForMaker）
    {
      "collectionGroup": "items",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "makerId", "order": "ASCENDING" },
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "displayOrder", "order": "ASCENDING" }
      ]
    },

    // =========================================================
    // shops
    // =========================================================
    // 全店舗: isActive + 広告優先 + 評価順
    {
      "collectionGroup": "shops",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "isFeatured", "order": "DESCENDING" },
        { "fieldPath": "rating", "order": "DESCENDING" }
      ]
    },
    // 業種フィルタ: isActive + type + isFeatured
    {
      "collectionGroup": "shops",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "type", "order": "ASCENDING" },
        { "fieldPath": "isFeatured", "order": "DESCENDING" }
      ]
    },
    // 地域フィルタ: isActive + prefecture + isFeatured
    {
      "collectionGroup": "shops",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "prefecture", "order": "ASCENDING" },
        { "fieldPath": "isFeatured", "order": "DESCENDING" }
      ]
    },
    // 注目店舗のみ: isActive + isFeatured + rating
    {
      "collectionGroup": "shops",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "isFeatured", "order": "ASCENDING" },
        { "fieldPath": "rating", "order": "DESCENDING" }
      ]
    },
    // サービスカテゴリ: isActive + services(array) + rating
    {
      "collectionGroup": "shops",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "services", "arrayConfig": "CONTAINS" },
        { "fieldPath": "rating", "order": "DESCENDING" }
      ]
    },
    // 対応メーカー: isActive + supportedMakerIds(array) + rating
    {
      "collectionGroup": "shops",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "supportedMakerIds", "arrayConfig": "CONTAINS" },
        { "fieldPath": "rating", "order": "DESCENDING" }
      ]
    },

    // =========================================================
    // part_listings
    // =========================================================
    // おすすめパーツ: isActive + isFeatured + rating
    {
      "collectionGroup": "part_listings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "isFeatured", "order": "DESCENDING" },
        { "fieldPath": "rating", "order": "DESCENDING" }
      ]
    },
    // カテゴリ絞り込み: isActive + category + isFeatured + rating
    {
      "collectionGroup": "part_listings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "category", "order": "ASCENDING" },
        { "fieldPath": "isFeatured", "order": "DESCENDING" },
        { "fieldPath": "rating", "order": "DESCENDING" }
      ]
    },
    // 注目パーツ: isActive + isFeatured(==true) + rating
    {
      "collectionGroup": "part_listings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "isFeatured", "order": "ASCENDING" },
        { "fieldPath": "rating", "order": "DESCENDING" }
      ]
    },
    // タグ検索: isActive + tags(array) + rating
    {
      "collectionGroup": "part_listings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "tags", "arrayConfig": "CONTAINS" },
        { "fieldPath": "rating", "order": "DESCENDING" }
      ]
    },

    // =========================================================
    // user_part_listings
    // =========================================================
    // 出品者の出品一覧（新着順）
    {
      "collectionGroup": "user_part_listings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "sellerId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },

    // =========================================================
    // inquiries
    // =========================================================
    // ユーザー問い合わせ一覧
    {
      "collectionGroup": "inquiries",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "updatedAt", "order": "DESCENDING" }
      ]
    },
    // 店舗問い合わせ一覧
    {
      "collectionGroup": "inquiries",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "shopId", "order": "ASCENDING" },
        { "fieldPath": "updatedAt", "order": "DESCENDING" }
      ]
    },
    // 店舗の月次集計（受信件数・月次レポート / createdAt 範囲）
    {
      "collectionGroup": "inquiries",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "shopId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "ASCENDING" }
      ]
    },
    // ユーザー未読カウント
    {
      "collectionGroup": "inquiries",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "unreadCountUser", "order": "DESCENDING" }
      ]
    },
    // 店舗未読カウント
    {
      "collectionGroup": "inquiries",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "shopId", "order": "ASCENDING" },
        { "fieldPath": "unreadCountShop", "order": "ASCENDING" }
      ]
    },
    // ユーザー問い合わせ ステータスフィルタ付き
    {
      "collectionGroup": "inquiries",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "updatedAt", "order": "DESCENDING" }
      ]
    },
    // 店舗問い合わせ ステータスフィルタ付き
    {
      "collectionGroup": "inquiries",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "shopId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "updatedAt", "order": "DESCENDING" }
      ]
    },

    // =========================================================
    // posts (SNS)
    // =========================================================
    // 全公開フィード
    {
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "visibility", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    // カテゴリフィルタ付きフィード
    {
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "visibility", "order": "ASCENDING" },
        { "fieldPath": "category", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    // ユーザー自身の投稿
    {
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    // 他ユーザーのプロフィール投稿（公開のみ）
    {
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "visibility", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    // ハッシュタグ検索
    {
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "hashtags", "arrayConfig": "CONTAINS" },
        { "fieldPath": "visibility", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    // SNS同車種フィルタ（「同じ○○オーナー」チップ）
    {
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "visibility", "order": "ASCENDING" },
        { "fieldPath": "vehicleTag.modelName", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    // パーツ提案: 同車種オーナーの装着例（カテゴリ + 車種）
    {
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "visibility", "order": "ASCENDING" },
        { "fieldPath": "category", "order": "ASCENDING" },
        { "fieldPath": "vehicleTag.modelName", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    // 並び替え「コメントが多い順」。カテゴリの複数選択は whereIn なので、
    // 等価フィルタと同じ扱いになり category ありの組と共用できる。
    {
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "visibility", "order": "ASCENDING" },
        { "fieldPath": "commentCount", "order": "DESCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    // 「コメントが多い順」+ カテゴリ絞り込み
    {
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "visibility", "order": "ASCENDING" },
        { "fieldPath": "category", "order": "ASCENDING" },
        { "fieldPath": "commentCount", "order": "DESCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    // 「コメントが多い順」+ 同車種フィルタ
    {
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "visibility", "order": "ASCENDING" },
        { "fieldPath": "vehicleTag.modelName", "order": "ASCENDING" },
        { "fieldPath": "commentCount", "order": "DESCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    // ハッシュタグ絞り込み + 「コメントが多い順」
    {
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "hashtags", "arrayConfig": "CONTAINS" },
        { "fieldPath": "visibility", "order": "ASCENDING" },
        { "fieldPath": "commentCount", "order": "DESCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    // ハッシュタグ + カテゴリ絞り込み
    {
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "hashtags", "arrayConfig": "CONTAINS" },
        { "fieldPath": "visibility", "order": "ASCENDING" },
        { "fieldPath": "category", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    // 「コメントが多い順」+ カテゴリ + 同車種
    {
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "visibility", "order": "ASCENDING" },
        { "fieldPath": "category", "order": "ASCENDING" },
        { "fieldPath": "vehicleTag.modelName", "order": "ASCENDING" },
        { "fieldPath": "commentCount", "order": "DESCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },

    // =========================================================
    // comments
    // =========================================================
    {
      "collectionGroup": "comments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "postId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "ASCENDING" }
      ]
    },

    // =========================================================
    // notifications
    // =========================================================
    {
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "isRead", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },

    // =========================================================
    // drive_logs
    // =========================================================
    // ユーザーのドライブ履歴（startTime: モデルの正しいフィールド名）
    {
      "collectionGroup": "drive_logs",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "startTime", "order": "DESCENDING" }
      ]
    },
    // 公開ドライブフィード: isPublic + status + createdAt
    {
      "collectionGroup": "drive_logs",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isPublic", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    // ユーザーの完了ドライブ数カウント用
    {
      "collectionGroup": "drive_logs",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" }
      ]
    },

    // =========================================================
    // drive_waypoints
    // =========================================================
    {
      "collectionGroup": "drive_waypoints",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "driveLogId", "order": "ASCENDING" },
        { "fieldPath": "timestamp", "order": "ASCENDING" }
      ]
    },

    // =========================================================
    // spots (ドライブスポット)
    // =========================================================
    {
      "collectionGroup": "spots",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isPublic", "order": "ASCENDING" },
        { "fieldPath": "name", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "spots",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isPublic", "order": "ASCENDING" },
        { "fieldPath": "visitCount", "order": "DESCENDING" }
      ]
    },

    // =========================================================
    // spot_ratings / spot_favorites / spot_visits
    // =========================================================
    {
      "collectionGroup": "spot_ratings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "spotId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "spot_favorites",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "spot_visits",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "visitedAt", "order": "DESCENDING" }
      ]
    },

    // =========================================================
    // safety_tips
    // =========================================================
    // 全件 (isActive + publishedAt)
    {
      "collectionGroup": "safety_tips",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "publishedAt", "order": "DESCENDING" }
      ]
    },
    // カテゴリフィルタ付き (isActive + category + publishedAt)
    {
      "collectionGroup": "safety_tips",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "category", "order": "ASCENDING" },
        { "fieldPath": "publishedAt", "order": "DESCENDING" }
      ]
    },

    // =========================================================
    // vehicle_sharing_permissions
    // =========================================================
    // getPermittedShops: 車両オーナーが許可した工場IDリストを取得
    //   .where('vehicleId', isEqualTo: vehicleId).where('isActive', isEqualTo: true)
    {
      "collectionGroup": "vehicle_sharing_permissions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "vehicleId", "order": "ASCENDING" },
        { "fieldPath": "isActive", "order": "ASCENDING" }
      ]
    },
    // getPermittedVehicles: 工場が閲覧許可された車両IDリストを取得
    //   .where('shopId', isEqualTo: shopId).where('isActive', isEqualTo: true)
    {
      "collectionGroup": "vehicle_sharing_permissions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "shopId", "order": "ASCENDING" },
        { "fieldPath": "isActive", "order": "ASCENDING" }
      ]
    }

    ,

    // =========================================================
    // shop_inquiry_demands (Issue #41 Phase 2)
    // =========================================================
    // getDemandsForShop: shopId フィルタ + createdAt 降順
    {
      "collectionGroup": "shop_inquiry_demands",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "shopId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    }

  ],
  "fieldOverrides": []
}
